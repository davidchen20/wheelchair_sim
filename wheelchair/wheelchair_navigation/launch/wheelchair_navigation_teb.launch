<launch>
  <arg name="map_file" default="$(find wheelchair_navigation)/maps/GGB_lab.yaml"/>
  <!-- Same recorded lab map pose as wheelchair_navigation.launch. -->
  <arg name="initial_pose_x" default="5.150847450733085"/>
  <arg name="initial_pose_y" default="6.446909230418239"/>
  <arg name="initial_pose_a" default="3.139226658721223"/>

  <include file="$(find wheelchair_navigation)/launch/wheelchair_navigation.launch">
    <arg name="model" value="waffle"/>
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
    <arg name="move_base_launch" value="$(find wheelchair_navigation)/launch/move_base_teb.launch"/>
  </include>
</launch>
