      <origin
        xyz="-0.0355 0 0"
        rpy="0 0 0" />
      <mass
        value="1.15149423065159" />
      <inertia
        ixx="0.00297224986246798"
        ixy="0"
        ixz="0"
        iyy="0.00196984846596022"
