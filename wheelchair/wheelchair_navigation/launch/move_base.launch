<launch>
  <!-- Arguments -->
  <arg name="model" default="$(env TURTLEBOT3_MODEL)" doc="model type [burger, waffle, waffle_pi]"/>
  <arg name="cmd_vel_topic" default="/cmd_vel" />
  <arg name="odom_topic" default="odom" />
  <arg name="move_forward_only" default="false"/>
  <arg name="controller"  default="mpc" doc="opt: dwa, mpc, pure_pursuit"/> 
  <arg name="map_topic" default="map" />

  <!-- move_base -->

  <!-- <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS" />
    <param name="base_local_planner" value="mpc_ros/MPCPlannerROS" />
    <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"  />    
    <rosparam file="$(find wheelchair_navigation)/param/costmap_common_params_wheelchair.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find wheelchair_navigation)/param/costmap_common_params_wheelchair.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find wheelchair_navigation)/param/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find wheelchair_navigation)/param/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find wheelchair_navigation)/param/move_base_params.yaml" command="load" />
    <rosparam file="$(find wheelchair_navigation)/param/base_local_planner_params.yaml" command="load" />
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
    <param name="DWAPlannerROS/min_vel_x" value="0.0" if="$(arg move_forward_only)" />
  </node> -->

  <node pkg="move_base" type="move_base" name="move_base" respawn="true" output="screen">
    <rosparam file="$(find wheelchair_navigation)/params/mpc_params/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find wheelchair_navigation)/params/mpc_params/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find wheelchair_navigation)/params/mpc_params/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find wheelchair_navigation)/params/mpc_params/global_costmap_params.yaml" command="load" />
    
    <rosparam file="$(find mpc_ros)/params/mpc_last_params.yaml" command="load" />
    <param name="planner_frequency" value="1.0" />
    <param name="planner_patience" value="5.0" />

    <param name="base_local_planner" value="mpc_ros/MPCPlannerROS" />
    <param name="controller_frequency" value="5.0" />
    <param name="controller_patience" value="15.0" />

    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
    <remap from="map" to="$(arg map_topic)" />
  </node>

  <!-- <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS" />
    <rosparam file="$(find wheelchair_navigation)/params/dwa_params/costmap_common_params_$(arg model).yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find wheelchair_navigation)/params/dwa_params/costmap_common_params_$(arg model).yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find wheelchair_navigation)/params/dwa_params/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find wheelchair_navigation)/params/dwa_params/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find wheelchair_navigation)/params/dwa_params/move_base_params.yaml" command="load" />
    <rosparam file="$(find wheelchair_navigation)/params/dwa_params/dwa_local_planner_params_$(arg model).yaml" command="load" />
    <remap from="cmd_vel" to="$(arg cmd_vel_topic)"/>
    <remap from="odom" to="$(arg odom_topic)"/>
    <param name="DWAPlannerROS/min_vel_x" value="0.0" if="$(arg move_forward_only)" />
  </node> -->
