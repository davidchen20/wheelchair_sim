<?xml version="1.0" ?>
<robot name="wheelchair" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find wheelchair_description)/urdf/common_properties.xacro"/>
  <xacro:include filename="$(find wheelchair_description)/urdf/wheelchair.gazebo.xacro"/>

 <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.010" rpy="0 0 0"/>
  </joint>
<link name="base_link">
    <inertial>
      <origin
        xyz="-0.015 0.451 -0.055" rpy="0 0 0" />
      <mass value="10.435" />
      <inertia
        ixx="2.7713"
        ixy="0.00090583"
        ixz="-0.0013395"
        iyy="3.4431"
        iyz="0.087281"
        izz="1.8166" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.57" />
      <geometry>
        <mesh
          filename="package://wheelchair_description/meshes/bases/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.25098 0.25098 0.25098 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 1.57" />
      <geometry>
        <mesh
          filename="package://wheelchair_description/meshes/bases/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link
    name="wheel_left_link">
    <inertial>
      <origin
        xyz="0 0 0" rpy="0 0 0" />
      <mass value="10.8107" />
      <inertia
        ixx="0.077834"
        ixy="0"
        ixz="0"
        iyy="0.04066"
        iyz="0"
        izz="0.04066" />
    </inertial>
    <visual>
      <origin xyz="-0.276 0 0" rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wheelchair_description/meshes/bases/mw_L_Link.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.276 0 0" rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wheelchair_description/meshes/bases/mw_L_Link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="wheel_left_joint"
    type="continuous">
    <origin xyz="0 0.276 0.166" rpy="0 0 1.57" />
    <parent link="base_link" />
    <child link="wheel_left_link" />
    <axis xyz="1 0 0" />
  </joint>
  <link
    name="wheel_right_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass
        value="10.81073460408934" />
      <inertia
        ixx="0.0778339439539713"
        ixy="0"
        ixz="0"
        iyy="0.0406602768846022"
        iyz="0"
        izz="0.0406602771222891" />
    </inertial>
    <visual>
      <origin xyz="0.276 0 0" rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wheelchair_description/meshes/bases/mw_R_Link.STL" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.276 0 0" rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wheelchair_description/meshes/bases/mw_R_Link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="wheel_right_joint"
    type="continuous">
    <origin xyz="0 -0.276 0.166" rpy="0 0 1.57" />
    <parent
      link="base_link" />
    <child
      link="wheel_right_link" />
    <axis xyz="1 0 0" />
  </joint>
  <link
    name="aw_lb_Link">
    <inertial>
      <origin
        xyz="0.0355 0 0"
        rpy="0 0 0" />
      <mass
        value="1.15149423065159" />
      <inertia
        ixx="0.00297224986246798"
        ixy="0"
        ixz="0"
