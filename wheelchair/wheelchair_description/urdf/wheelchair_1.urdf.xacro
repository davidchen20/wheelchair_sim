  </link>
  <joint
    name="aw_rb_Joint"
    type="continuous">
    <origin
      xyz="-0.47457 -0.1677 0.071852"
      rpy="1.5708 0 1.57" />
    <parent
      link="base_link" />
    <child
      link="aw_rb_Link" />
    <axis
