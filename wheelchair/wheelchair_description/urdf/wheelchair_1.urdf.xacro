    <child
      link="aw_lf_Link" />
    <axis
      xyz="1 0 0" />
  </joint>
  <link
    name="aw_rf_Link">
    <inertial>
      <origin
        xyz="-0.0355 0 2.77555756156289E-17"
        rpy="0 0 0" />
      <mass
        value="1.15149423065159" />
       <inertia
        ixx="0.00297224986246799"
        ixy="5.3060125602216E-19"
        ixz="2.29354799357753E-19"
        iyy="0.00196984846596022"
